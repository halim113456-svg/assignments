function reverseInPlace(array) {
    let left = 0;
    let right = array.length - 1;

    while (left < right) {
        let temp = array[left];
        array[left] = array[right];
        array[right] = temp;

        left++;
        right--;
    }

    return array;
}

 Space Complexity

This version reverses the array directly instead of creating a second array. Only a few extra variables are used.

Big O Space Complexity: O(1)


