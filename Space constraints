function reverse(array) { 
    let newArray = [];

    for (let i = array.length - 1; i >= 0; i--) { 
        newArray.push(array[i]);
    }

    return newArray;
}

 Space Complexity

This function creates a second array to store reversed values. The new array stores every item from the original array.

**Big O Space Complexity: O(n)**



