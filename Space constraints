 #1
Code
function doubleArray1(array) { 
    let newArray = [];

    for (let i = 0; i < array.length; i++) { 
        newArray.push(array[i] * 2);
    }

    return newArray; 
}

Explanation

This function loops through the array once and creates a new array.

- Time Complexity: O(n)
- Space Complexity: O(n)


 #2
Code
function doubleArray2(array) {
    for (let i = 0; i < array.length; i++) {
        array[i] *= 2;
    }

    return array; 
}


 Explanation

This version changes the original array directly without creating a second array.

- Time Complexity: O(n)
- Space Complexity: O(1)


#3
Code
function doubleArray3(array, index = 0) { 
    if (index >= array.length) {
        return;
    }

    array[index] *= 2;

    doubleArray3(array, index + 1);

    return array; 
}
 Explanation

This version uses recursion. Recursive calls use stack memory, which increases space usage.

- Time Complexity: O(n)
- Space Complexity: O(n)




